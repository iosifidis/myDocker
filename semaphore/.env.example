# =========================================================
# Semaphore UI - Environment Variables & Secrets
# Copy to .env and NEVER commit .env publicly
# =========================================================

# --- Database (SQLite, single file inside ./data) ---
SEMAPHORE_DB_DIALECT=sqlite

# --- Initial Admin Account ---
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_NAME=Administrator
SEMAPHORE_ADMIN_EMAIL=admin@iosifidis.gr
SEMAPHORE_ADMIN_PASSWORD=change_this_strong_password

# --- Encryption / Cookies (generate with: openssl rand -base64 32) ---
# Do NOT change these after initial setup
SEMAPHORE_COOKIE_HASH=change_this_cookie_hash
SEMAPHORE_COOKIE_ENCRYPTION=change_this_cookie_encryption_key
SEMAPHORE_ACCESS_KEY_ENCRYPTION=change_this_access_key_encryption

# --- Web Root ---
SEMAPHORE_WEB_ROOT=https://infra.iosifidis.gr

# --- SMTP Configuration ---
SEMAPHORE_EMAIL_SENDER=semaphore@iosifidis.gr
SEMAPHORE_EMAIL_HOST=mail.iosifidis.gr
SEMAPHORE_EMAIL_PORT=587
SEMAPHORE_EMAIL_USERNAME=server@iosifidis.gr
SEMAPHORE_EMAIL_PASSWORD=change_this_smtp_password
# Set SEMAPHORE_EMAIL_SECURE=True ONLY for port 465 (implicit TLS/SSL)
SEMAPHORE_EMAIL_SECURE=False
